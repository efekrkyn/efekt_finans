[DEFAULT]
ignoreip = 127.0.0.1/8 ::1 104.248.31.42
bantime = 10m
findtime = 10m
maxretry = 50

[nginx-limit-req]
enabled = true
port    = http,https
filter  = nginx-limit-req
logpath = /var/log/nginx/*error.log
maxretry = 100
findtime = 10m

[nginx-botsearch]
enabled = true
port     = http,https
filter   = nginx-botsearch
logpath  = /var/log/nginx/*error.log
maxretry = 10
