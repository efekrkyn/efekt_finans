# Vercel deploy sırasında upload edilmemesi gerekenler.
# NOT: gateway/, cron/, tools/* — daha önce ignored idi ama transitive
# import zinciri (server.ts → llm.ts → prompts.ts → tools/registry →
# cron-tool/heartbeat-tool → gateway/cron) runtime'da
# ERR_MODULE_NOT_FOUND ile patladı. Şimdi hepsi yüklü, sadece chat
# endpoint çağrılırsa devreye girer. Function size sınırı altında.

# Sadece açıkça gereksiz olanlar:
src/cli.ts
src/commands/
src/evals/
src/index.tsx
src/find_*.cjs
src/fix_*.cjs
src/recover.cjs
src/rebuild.cjs
src/restore_app.cjs
src/test-*.ts

# Build & cache
dashboard/node_modules/
dashboard/dist/

# Local
.env
.dexter/
.github/
*.test.ts
*.test.tsx
node_modules/

